@page "/facl/faclprofile"
@using ClassLibraryDAL
@using ClassLibraryModel
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Faculty")]

<h3 class="text-center">Faculty Profile</h3>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var item in faclData)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-center mb-3">
                        <img src="@item.FaclImage" class="rounded-circle faculty-image" alt="Faculty Image">
                    </div>
                    <h5 class="card-title text-center mb-3">@item.FaclFirstName @item.FaclLastName</h5>
                    <ul class="list-unstyled">
                        <li><strong>Gender:</strong> @item.GenderName</li>
                        <li><strong>CNIC:</strong> @item.FaclCNIC</li>
                        <li><strong>Phone No:</strong> @item.FaclPhoneNo</li>
                        <li><strong>Email:</strong> @item.FaclEmail</li>
                        <li><strong>Country:</strong> @item.CountryName</li>
                        <li><strong>City:</strong> @item.CityName</li>
                        <li><strong>Address:</strong> @item.FaclAddress</li>
                        <li><strong>Department:</strong> @item.DeptName</li>
                        <li><strong>Active:</strong> @item.FaclIsActive</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="facl/editfaclprofile/@item.FaclID" class="btn btn-primary me-md-2">Edit Profile</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .faculty-image {
        width: 120px;
        height: 120px;
        object-fit: cover;
    }
</style>

@code {
    private string? email;
    private IEnumerable<Claim> claims = Enumerable.Empty<Claim>();

    private List<FaclModel> faclData { get; set; } = new List<FaclModel>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            claims = user.Claims;
            email = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value;
            faclData = FaclDAL.GetFaclByEmail(email);
        }
    }
}