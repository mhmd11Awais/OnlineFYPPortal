@page "/facl/projectproposal"
@using ClassLibraryDAL
@using ClassLibraryModel
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Faculty")]

<h3 class="text-center mb-4">Project Proposal</h3>

<div class="d-flex justify-content-end mb-4">
    <a href="facl/editprojectproposal" class="btn btn-primary me-2">Propose Project</a>
    <a href="facl/pendingprojects" class="btn btn-primary">Pending Projects</a>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var item in projectData)
    {
        <div class="col">
            <div class="card h-100 border-primary shadow">
                <div class="card-body">
                    <h6 class="card-title">Project ID: @item.ProjID</h6>
                    <h5 class="card-title">@item.ProjTitle</h5>
                    <p class="card-text">Details: @item.ProjDetails</p>
                    <p class="card-text">Active: @item.ProjIsActive</p>
                </div>
                <div class="card-footer">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="facl/editprojectproposal/@item.ProjID" class="btn btn-outline-primary me-2">Edit</a>
                        <a href="facl/requestresponse/@item.ProjID" class="btn btn-outline-primary">Requests</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .card {
        border-width: 2px;
        border-radius: 10px;
        transition: transform 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .border-primary {
        border-color: #007bff !important;
    }

    .text-primary {
        color: #007bff !important;
    }

    .btn-primary {
        background-color: #2c3e50;
        border-color: #2c3e50;
        color: #ffffff;
    }

        .btn-primary:hover {
            background-color: #34495e;
            border-color: #34495e;
        }

    .btn-outline-primary {
        color: #2c3e50;
        border-color: #2c3e50;
    }

        .btn-outline-primary:hover {
            background-color: #2c3e50;
            border-color: #2c3e50;
            color: #ffffff;
        }
</style>

@code {

    private int Fid;
    private string? email;
    private IEnumerable<Claim> claims = Enumerable.Empty<Claim>();

    private List<FaclModel> faclData { get; set; } = new List<FaclModel>();
    private List<ProjectModel> projectData { get; set; } = new List<ProjectModel>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            claims = user.Claims;
            email = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value;
            faclData = FaclDAL.GetFaclByEmail(email);
            foreach (var item in faclData)
            {
                Fid = item.FaclID;
            }
            projectData = ProjectDAL.GetActiveProjectsByFaculty(Fid);
        }
    }
}
