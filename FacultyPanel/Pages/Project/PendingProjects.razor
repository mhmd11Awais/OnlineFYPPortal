@page "/facl/pendingprojects"
@using ClassLibraryDAL
@using ClassLibraryModel
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Faculty")]

<h3>PendingProjects</h3>

<br />
<br />
<div class="row row-cols-1 row-cols-md-2 g-4">
	@foreach (var item in projectData)
	{
		<div class="col">
			<div class="card h-100">
				<div class="card-body">
					<h6 class="card-title">Project ID: @item.ProjID</h6>
					<h5 class="card-title">@item.ProjTitle</h5>
					@*<h6 class="card-title">Details: @item.ProjDetails</h6>*@
					<h6 class="card-title">Supervisor ID: @item.SupID</h6>
					<h6 class="card-title">Faculty: @item.FaclFirstName @item.FaclLastName</h6>
					<h6 class="card-title">Supervisor Active: @item.SupIsActive</h6>
					<h6 class="card-title">Student Group ID: @item.SgID</h6>
					<h6 class="card-title">Group Name: @item.SgName</h6>
					<h6 class="card-title">Project Pending: @item.ProjIsActive</h6>
					<h6 class="card-title">Project Active: @item.ProjIsActive</h6>
				</div>
				<div class="card-footer">
					<div class="d-grid gap-2 d-md-flex justify-content-md-end">
						<a href="facl/assignprojecttasks/@item.SupID" class="btn btn-outline-primary me-md-2 mb-2 mb-md-0">Assign Task</a>
						@*<a href="fypsubmission/createfypsubmission/@item.SupID" class="btn btn-outline-primary me-md-2 mb-2 mb-md-0">Create Submission</a>
					*@</div>
			</div>
			</div>
		</div>
	}
</div>

@code {
	private int Fid;
	private string? email;
	private IEnumerable<Claim> claims = Enumerable.Empty<Claim>();

	private List<FaclModel> faclData { get; set; } = new List<FaclModel>();
	private List<ProjectModel> projectData { get; set; } = new List<ProjectModel>();

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		if (user.Identity is not null && user.Identity.IsAuthenticated)
		{
			claims = user.Claims;
			email = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value;
			faclData = FaclDAL.GetFaclByEmail(email);
			foreach (var item in faclData)
			{
				Fid = item.FaclID;
			}
			projectData = ProjectDAL.GetPendingProjectsByFaculty(Fid);
		}
	}
}
