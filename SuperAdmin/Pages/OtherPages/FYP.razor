@page "/others/fyp"
@using ClassLibraryDAL
@using ClassLibraryModel
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Administrator")]

<h3 class="mt-5">FYP</h3>
<br />

<EditForm Model="fpModel" OnSubmit="SaveFYP">
    <div class="d-flex align-items-center">
        <label class="me-2">FYP</label>
        <input type="text" class="form-control" @bind-value="fpModel.FYPTitle" placeholder="Enter FYP" />
        <button type="submit" class="btn btn-success btn-sm ms-2">@ButtonName</button>
    </div>
</EditForm>
<br />

<table class="table table-bordered mt-3">
    <thead class="thead-dark">
        <tr>
            <th scope="col">Sr#</th>
            <th scope="col">FYP Title</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in fypData)
        {
            <tr>
                <td>@item.FYPID</td>
                <td>@item.FYPTitle</td>
                <td>
                    <button class="btn btn-primary btn-sm me-2" @onclick="(()=>EditFYP(item.FYPID))">Edit</button>
                    <button class="btn btn-danger btn-sm" @onclick="(()=>ConfirmDelete(item.FYPID))">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {

	private List<FYPModel> fypData { get; set; } = new List<FYPModel>();
	private List<FYPModel> fpData { get; set; }

	public string? ButtonName { get; set; }

	public int fypID { get; set; }

	private FYPModel fypModel { get; set; } = new FYPModel();
	private FYPModel fpModel { get; set; } = new FYPModel();

	protected override void OnInitialized()
	{
		LoadFYP();
		ButtonName = "Save";
	}

	private void LoadFYP()
	{
		fypData = FYPDAL.GetFYP();
	}

	private async Task ConfirmDelete(int FaclID)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this item?");
		if (confirmed)
		{
			DeleteFYP(FaclID);
		}
	}

	private void DeleteFYP(int FYPID)
	{
		if (FYPDAL.DeleteFYP(FYPID) == 1)
		{
			LoadFYP();
		}
	}

	private void EditFYP(int FYPID)
	{
		ButtonName = "Edit";
		fypID = FYPID;
		GetData();
		foreach (var item in fpData)
		{
			fpModel.FYPID = item.FYPID;
			fpModel.FYPTitle = item.FYPTitle;
		}
	}

	private void SaveFYP()
	{
		if (ButtonName == "Save")
		{
			if (FYPDAL.SaveFYP(fpModel) == 1)
			{
				LoadFYP();
			}
			fpModel.FYPTitle = "";
		}
		else
		{
			fpModel.FYPID = fypID;
			if (FYPDAL.EditFYP(fpModel) == 1)
			{
				LoadFYP();
			}
			ButtonName = "Save";
			fpModel.FYPTitle = "";
		}
	}

	private void GetData()
	{
		fpData = FYPDAL.GetFYPByID(fypID);
	}

	private void AddFYP()
	{
		fpModel.FYPTitle = "";
		ButtonName = "Save";
	}

}

