@page "/std/student"
@using ClassLibraryDAL
@using ClassLibraryModel
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Administrator")]

<h3 class="text-center mt-5">Students</h3>

<style>
    .student-card {
        max-width: 300px;
        margin: 0 auto;
    }

    .student-image {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        margin: 0 auto;
    }
</style>


<div class="container mt-4">
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var item in stdData)
        {
            <div class="col">
                <div class="card h-100 student-card">
                    <img class="card-img-top student-image" src="@item.StdImage" alt="Student Image">
                    <div class="card-body">
                        <h5 class="card-title text-center">@item.StdFirstName @item.StdLastName</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Student ID:</strong> @item.StdID</li>
                            <li class="list-group-item"><strong>Gender:</strong> @item.GenderName</li>
                            <li class="list-group-item"><strong>CNIC:</strong> @item.StdCNIC</li>
                            <li class="list-group-item"><strong>Phone No:</strong> @item.StdPhoneNo</li>
                            <li class="list-group-item"><strong>Email:</strong> @item.StdEmail</li>
                            <li class="list-group-item"><strong>Country:</strong> @item.CountryName</li>
                            <li class="list-group-item"><strong>City:</strong> @item.CityName</li>
                            <li class="list-group-item"><strong>Address:</strong> @item.StdAddress</li>
                            <li class="list-group-item"><strong>Last Education:</strong> @item.StdLastEducation</li>
                            <li class="list-group-item"><strong>Organization:</strong> @item.OrgName</li>
                            <li class="list-group-item"><strong>Department:</strong> @item.DeptName</li>
                            <li class="list-group-item"><strong>Active:</strong> @item.StdIsActive</li>
                        </ul>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex justify-content-end">
                            <a href="std/addnewstd/@item.StdID" class="btn btn-outline-primary me-2">Edit</a>
                            <button class="btn btn-outline-danger" @onclick="(()=>ConfirmDelete(item.StdID))">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {

	private List<StdModel> stdData { get; set; } = new List<StdModel>();

	protected override void OnInitialized()
	{
		LoadStd();
	}

	private void LoadStd()
	{
		stdData = StdDAL.GetStd();
	}

	private async Task ConfirmDelete(int StdID)
	{
		bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this item?");
		if (confirmed)
		{
			DeleteStd(StdID);
		}
	}

	private void DeleteStd(int StdID)
	{
		if (StdDAL.DeleteStd(StdID) == 1)
		{
			LoadStd();
		}
	}

}
