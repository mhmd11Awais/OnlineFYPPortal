@page "/exp/expertise"
@using ClassLibraryDAL
@using ClassLibraryModel
@attribute [Authorize(Roles = "Administrator")]

<h3 class="mt-5">Expertise</h3>
<br />
<a href="exp/addnewexp" class="btn btn-primary btn-sm">Add Expertise</a>
<br />
<br />

<table class="table table-bordered mt-3">
    <thead class="thead-dark">
        <tr>
            <th scope="col">Sr#</th>
            <th scope="col">Title</th>
            <th scope="col">Abbreviation</th>
            <th scope="col">Active</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in expData)
        {
            <tr>
                <td>@item.ExpID</td>
                <td>@item.ExpTitle</td>
                <td>@item.Abbreviation</td>
                <td>@item.ExpIsActive</td>
                <td>
                    <a href="exp/addnewexp/@item.ExpID" class="btn btn-primary btn-sm">Edit</a>
                    <button class="btn btn-danger btn-sm" @onclick="(()=>DeleteExp(item.ExpID))">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>



@code {
	private List<ExpModel> expData { get; set; } = new List<ExpModel>();

	protected override void OnInitialized()
	{
		LoadExp();
	}

	private void LoadExp()
	{
		expData = ExpDAL.GetExp();
	}

	private void DeleteExp(int ExpID)
	{
		if (ExpDAL.DeleteExp(ExpID) == 1)
		{
			LoadExp();
		}
	}
}
