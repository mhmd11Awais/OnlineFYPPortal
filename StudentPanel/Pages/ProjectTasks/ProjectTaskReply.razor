@page "/projecttasks/projecttaskreply"
@using ClassLibraryDAL
@using ClassLibraryModel
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject NavigationManager nm
@attribute [Authorize(Roles = "Student")]

<h3 class="text-center mb-4">Project Tasks</h3>
<br />
<div class="alert alert-success" role="alert" hidden="@showAlert">
	@errorMessage
</div>
<br />
<div class="row row-cols-1 row-cols-md-2 g-4">
	@foreach (var item in projectTaskData)
	{
		<div class="col">
			<div class="card h-100 border-primary shadow">
				<div class="card-body">
					<h6 class="card-title">Task ID: @item.TaskID</h6>
					<h5 class="card-title">@item.TaskTitle</h5>
					<h6 class="card-title">Details: @item.TaskDetails</h6>
					<h6 class="card-title">Supervisor: @item.FaclFirstName @item.FaclLastName</h6>
					<h6 class="card-title">Project: @item.ProjTitle</h6>
					<h6 class="card-title">Group: @item.SgName</h6>
					@if (item.TaskIsCompleted != null)
					{
						<h5 class="card-title">Task Completed: @item.TaskIsCompleted</h5>
					}
				</div>
				@if (item.TaskIsCompleted == null)
				{
					<div class="card-footer">
						<div class="d-grid gap-2 d-md-flex justify-content-md-end">
							<button class="btn btn-outline-primary btn-sm" @onclick="(()=>ProjectTaskCompleted(item.TaskID))">Completed</button>
							<button class="btn btn-outline-danger btn-sm" @onclick="(()=>ProjectTaskInComplete(item.TaskID))">InComplete</button>
						</div>
					</div>
				}
			</div>
		</div>
	}
</div>

<style>
	.card {
		border-width: 2px;
		border-radius: 10px;
		transition: transform 0.3s;
	}

		.card:hover {
			transform: translateY(-5px);
		}

	.border-primary {
		border-color: #007bff !important;
	}

	.text-primary {
		color: #007bff !important;
	}
</style>

@code {

	private string? email;
	private IEnumerable<Claim> claims = Enumerable.Empty<Claim>();

	private bool? showAlert = true;
	private string? errorMessage;

	private List<ProjectTaskModel> projectTaskData { get; set; } = new List<ProjectTaskModel>();
	private ProjectTaskModel projectTaskModel { get; set; } = new ProjectTaskModel();

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		if (user.Identity is not null && user.Identity.IsAuthenticated)
		{
			claims = user.Claims;
			email = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value;

			projectTaskData = ProjectTaskDAL.ViewTasks();
		}
	}

	private void ProjectTaskCompleted(int TaskID)
	{
		projectTaskModel.TaskID = TaskID;
		projectTaskModel.TaskIsCompleted = true;
		if (ProjectTaskDAL.UpdateTaskCompletion(projectTaskModel) == 1)
		{
			nm.NavigateTo("ann/announcements");
		}
		else
		{
			errorMessage = "Failed to Reply Task Completion";
			ShowAlert();
		}
	}

	private void ProjectTaskInComplete(int TaskID)
	{
		projectTaskModel.TaskID = TaskID;
		projectTaskModel.TaskIsCompleted = false;
		if (ProjectTaskDAL.UpdateTaskCompletion(projectTaskModel) == 1)
		{
			nm.NavigateTo("ann/announcements");
		}
		else
		{
			errorMessage = "Failed to Reply Task Completion";
			ShowAlert();
		}
	}

	private async Task ShowAlert()
	{
		showAlert = false;
		StateHasChanged();

		await Task.Delay(3000); // Wait for 5 seconds

		await InvokeAsync(() =>
		{
			showAlert = true;
			StateHasChanged();
		});
	}

}
