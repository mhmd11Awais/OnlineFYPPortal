@page "/"
@using ClassLibraryDAL
@using ClassLibraryModel
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Index</PageTitle>

<div class="row">
    <AuthorizeView Roles="Student">
        <Authorized>
            <div class="col-md-4 mb-4" @onclick='() => NavigateToPage("ann/announcements")'>
                <div class="card text-center">
                    <div class="card-body">
                        <i class="bi bi-megaphone-fill text-primary" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3">Announcements</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4" @onclick='() => NavigateToPage("std/student")'>
                <div class="card text-center">
                    <div class="card-body">
                        <i class="bi bi-person-fill text-warning" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3">Profile</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4" @onclick='() => NavigateToPage("stdgroup/group")'>
                <div class="card text-center">
                    <div class="card-body">
                        <i class="bi bi-people-fill text-success" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3">Group</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4" @onclick='() => NavigateToPage("projectrequest/selectproject")'>
                <div class="card text-center">
                    <div class="card-body">
                        <i class="bi bi-list-task text-danger" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3">Projects</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4" @onclick='() => NavigateToPage("projecttasks/projecttaskreply")'>
                <div class="card text-center">
                    <div class="card-body">
                        <i class="bi bi-journal-check text-success" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3">Tasks</h5>
                    </div>
                </div>
            </div>

        </Authorized>
    </AuthorizeView>
</div>

@code {
    private void NavigateToPage(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}
