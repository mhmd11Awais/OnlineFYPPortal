@page "/projectrequest/requestproject"
@using ClassLibraryDAL
@using ClassLibraryModel
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Student")]

<h3 class="text-center mb-4">Project Requests</h3>

<br />
<br />
<div class="row row-cols-1 row-cols-md-2 g-4">
	@foreach (var item in projectRequestData)
	{
		<div class="col">
			<div class="card h-100 border-primary shadow">
				<div class="card-body">
					<h6 class="card-title">Request ID: @item.RequestID</h6>
					<h5 class="card-title">Project Title: @item.ProjTitle</h5>
					@*<h6 class="card-title">Project Details: @item.ProjDetails</h6>*@
					<h6 class="card-title">Faculty: @item.FaclFirstName @item.FaclLastName</h6>
					<h5 class="card-title">Date: @item.RequestDate</h5>
					@if (item.IsAccepted==null)
					{
						<h5 class="card-title">Status: No Reply</h5>
					}
					else
					{
						<h5 class="card-title">Accepted: @item.IsAccepted</h5>
					}
				</div>
				<div class="card-footer">
					<div class="d-grid gap-2 d-md-flex justify-content-md-end">

					</div>
				</div>
			</div>
		</div>
	}
</div>

<style>
	.card {
		border-width: 2px;
		border-radius: 10px;
		transition: transform 0.3s;
	}

		.card:hover {
			transform: translateY(-5px);
		}

	.border-primary {
		border-color: #007bff !important;
	}

	.text-primary {
		color: #007bff !important;
	}
</style>

@code {
	private int Sid;
	private string? email;
	private IEnumerable<Claim> claims = Enumerable.Empty<Claim>();

	private List<StdModel> stdData { get; set; } = new List<StdModel>();
	private List<ProjectRequestModel> projectRequestData { get; set; } = new List<ProjectRequestModel>();

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		if (user.Identity is not null && user.Identity.IsAuthenticated)
		{
			claims = user.Claims;
			email = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value;
			stdData = StdDAL.GetStdByEmail(email);
			foreach (var item in stdData)
			{
				Sid = item.StdID;
			}
			projectRequestData = ProjectRequestDAL.GetProjectRequestsByStudent(Sid);
		}
	}

}
